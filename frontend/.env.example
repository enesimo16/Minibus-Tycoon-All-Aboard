# Bu dosyayi .env.local olarak kopyala ve kendi makinene gore duzenle.
# .env.local gitignore'dadir, repoya girmez.

# Backend API adresi (backend'i hangi portta calistiriyorsan o).
# Production build'de buraya backend'in herkese acik HTTPS adresi yazilir
# (orn. https://api.oyun.com) — bkz. README "Production dagitimi".
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000

# Analitik olaylarını deploy/commit ile eşlemek için her yayında benzersiz sürüm etiketi.
NEXT_PUBLIC_APP_VERSION=local-dev

# Admin kullanici adi frontend'e konmaz. Yetki backend'de FULLFILLED_ADMIN_USERNAME
# ve veritabanindaki aktif oturum birlikte dogrulanarak belirlenir.
