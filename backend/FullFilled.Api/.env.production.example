# Copy to .env on the VPS. Never commit the real .env file.
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_HTTP_PORTS=8080
HttpsRedirection__Enabled=false

# Docker Compose mounts the persistent minibus-data volume at /data.
ConnectionStrings__Default=Data Source=/data/fullfilled.db

# Exact public Vercel origin. Add Cors__AllowedOrigins__1 for a custom domain.
Cors__AllowedOrigins__0=https://your-project.vercel.app

# Must match one real username registered in this database.
FULLFILLED_ADMIN_USERNAME=your-admin-username

RateLimits__LoginPerMinute=10
RateLimits__GeneralPerMinute=300
