# Template only. Configure real values as secrets/environment variables on the host.
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_HTTP_PORTS=8080
HttpsRedirection__Enabled=false
ConnectionStrings__Default=Data Source=/data/fullfilled.db
Cors__AllowedOrigins__0=https://your-game.vercel.app
# Must match one real, password-protected username in the GameSaves database.
# Admin routes also require that account's current auth token; this value alone grants no access.
FULLFILLED_ADMIN_USERNAME=your-admin-username
RateLimits__LoginPerMinute=10
RateLimits__GeneralPerMinute=300
